// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ProjectMediaType {
  IMAGE
  VIDEO
}

enum ServiceCategory {
  THINK
  CREATE
  BUILD
  GROW
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  WON
  LOST
  ARCHIVED
}

/// Pre-submission and journey events attached to LeadSession (not Lead).
enum LeadSessionEventType {
  FORM_OPENED
  PACKAGE_SELECTED
  STEP_COMPLETED
  FORM_SUBMITTED
  WHATSAPP_OPENED
  FORM_ABANDONED
}

/// Post-submission CRM / lifecycle events attached to Lead.
enum LeadEventType {
  STATUS_CHANGED
  CONTACTED
  QUALIFIED
  WON
  LOST
}

enum OfferStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  EXPIRED
  DISABLED
}

/// Admin CMS access levels. OWNER manages admin users; ADMIN/EDITOR manage
/// content and leads; VIEWER is read-only. Enforced server-side on every
/// protected page and mutation via requireAdmin()/requireRole().
enum AdminRole {
  OWNER
  ADMIN
  EDITOR
  VIEWER
}

// ---------------------------------------------------------------------------
// Site settings
// ---------------------------------------------------------------------------

model SiteSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       Json
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Services
// ---------------------------------------------------------------------------

model Service {
  id            String          @id @default(cuid())
  slug          String          @unique
  nameAr        String
  nameEn        String
  category      ServiceCategory
  summaryAr     String
  summaryEn     String
  descriptionAr String
  descriptionEn String
  icon          String?
  imageUrl      String?
  isActive      Boolean         @default(true)
  displayOrder  Int             @default(0)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  deletedAt     DateTime?

  projectServices ProjectService[]

  @@index([category])
  @@index([isActive, displayOrder])
  @@index([deletedAt])
}

// ---------------------------------------------------------------------------
// Projects & media
// ---------------------------------------------------------------------------

model Project {
  id            String        @id @default(cuid())
  slug          String        @unique
  title         String
  clientName    String?
  industry      String?
  summary       String
  challenge     String?
  solution      String?
  duration      String?
  resultText    String?
  coverImageUrl String?
  coverImageAlt String?
  featured      Boolean       @default(false)
  status        ContentStatus @default(DRAFT)
  displayOrder  Int           @default(0)
  publishedAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  deletedAt     DateTime?

  media           ProjectMedia[]
  projectServices ProjectService[]

  @@index([slug])
  @@index([featured])
  @@index([status])
  @@index([displayOrder])
  @@index([publishedAt])
  @@index([deletedAt])
}

model ProjectMedia {
  id        String           @id @default(cuid())
  projectId String
  type      ProjectMediaType
  /// Cloudinary secure delivery URL (source of truth for rendering).
  url       String
  thumbnailUrl String?
  altText      String?
  caption      String?
  width        Int?
  height       Int?
  displayOrder Int              @default(0)
  /// Cloudinary asset public_id — required to manage/replace the asset later.
  /// Nullable to stay additive for any pre-existing rows.
  cloudinaryPublicId String?
  /// Cloudinary resource_type ("image" | "video").
  resourceType       String?
  /// Cloudinary format (e.g. "jpg", "mp4").
  format             String?
  /// Cloudinary bytes (file size).
  bytes              Int?
  /// Video duration in seconds (Cloudinary video assets only).
  duration           Float?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, displayOrder])
  @@index([cloudinaryPublicId])
}

model ProjectService {
  projectId String
  serviceId String
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@id([projectId, serviceId])
  @@unique([projectId, serviceId])
  @@index([serviceId])
}

// ---------------------------------------------------------------------------
// Packages & features
// ---------------------------------------------------------------------------

model Package {
  id            String        @id @default(cuid())
  slug          String        @unique
  name          String
  tagline       String?
  description   String
  idealFor      String?
  /// Null until a real business price is configured. Must be > 0 to publish.
  originalPrice Decimal?      @db.Decimal(12, 2)
  currency      String        @default("SAR")
  billingPeriod String?
  startTimeText String?
  revisionCount Int?
  isFeatured    Boolean       @default(false)
  status        ContentStatus @default(DRAFT)
  displayOrder  Int           @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  deletedAt     DateTime?

  features      PackageFeature[]
  offerPackages OfferPackage[]
  leads         Lead[]
  leadSessions  LeadSession[]

  @@index([status, displayOrder])
  @@index([isFeatured])
  @@index([deletedAt])
}

model PackageFeature {
  id           String   @id @default(cuid())
  packageId    String
  title        String
  description  String?
  category     String?
  included     Boolean  @default(true)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  package Package @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@index([packageId, displayOrder])
}

// ---------------------------------------------------------------------------
// Limited offers
// ---------------------------------------------------------------------------

model LimitedOffer {
  id          String      @id @default(cuid())
  slug        String      @unique
  name        String
  headline    String
  description String?
  startsAt    DateTime
  endsAt      DateTime
  maxSlots    Int?
  bookedSlots Int         @default(0)
  status      OfferStatus @default(DRAFT)
  isActive    Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  offerPackages OfferPackage[]

  @@index([status, isActive])
  @@index([startsAt, endsAt])
}

model OfferPackage {
  offerId    String
  packageId  String
  /// Discounted package price while the offer is active (source of truth).
  offerPrice Decimal  @db.Decimal(12, 2)
  displayOrder Int    @default(0)
  createdAt  DateTime @default(now())

  offer   LimitedOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)
  package Package      @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@id([offerId, packageId])
  @@unique([offerId, packageId])
  @@index([packageId])
}

// ---------------------------------------------------------------------------
// Social proof
// ---------------------------------------------------------------------------

model Testimonial {
  id             String        @id @default(cuid())
  clientName     String
  projectName    String?
  industry       String?
  quote          String
  clientImageUrl String?
  clientLogoUrl  String?
  screenshotUrl  String?
  serviceLabel   String?
  status         ContentStatus @default(DRAFT)
  /// Explicit confirmation that the client approved public display of their
  /// name/quote/image. Required before an admin may publish (enforced in
  /// the admin service layer, not the database).
  publicApprovalConfirmed Boolean       @default(false)
  displayOrder            Int           @default(0)
  publishedAt             DateTime?
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt
  deletedAt               DateTime?

  @@index([status, displayOrder])
  @@index([deletedAt])
}

model TrustMetric {
  id           String   @id @default(cuid())
  key          String   @unique
  label        String
  value        String
  prefix       String?
  suffix       String?
  isVerified   Boolean  @default(false)
  isActive     Boolean  @default(false)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([isActive, isVerified, displayOrder])
}

model ClientLogo {
  id           String   @id @default(cuid())
  name         String
  logoUrl      String
  websiteUrl   String?
  isActive     Boolean  @default(false)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([isActive, displayOrder])
}

// ---------------------------------------------------------------------------
// FAQs
// ---------------------------------------------------------------------------

model FAQ {
  id           String   @id @default(cuid())
  slug         String   @unique
  question     String
  answer       String
  category     String?
  isActive     Boolean  @default(true)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([isActive, displayOrder])
}

// ---------------------------------------------------------------------------
// Leads & journey tracking
// ---------------------------------------------------------------------------

model Lead {
  id                     String     @id @default(cuid())
  name                   String
  phone                  String
  projectName            String?
  industry               String?
  projectStage           String?
  requestedService       String?
  packageId              String?
  budgetRange            String?
  message                String?
  preferredContactMethod String?
  status                 LeadStatus @default(NEW)
  source                 String?
  referrer               String?
  landingUrl             String?
  utmSource              String?
  utmMedium              String?
  utmCampaign            String?
  utmContent             String?
  utmTerm                String?
  /// Admin-only CRM note. Never exposed publicly; never included in
  /// audit-log metadata verbatim.
  internalNote           String?
  /// Admin currently assigned to work this lead (optional).
  assignedAdminId        String?
  createdAt              DateTime   @default(now())
  updatedAt              DateTime   @updatedAt

  package       Package?      @relation(fields: [packageId], references: [id], onDelete: SetNull)
  assignedAdmin AdminUser?    @relation(fields: [assignedAdminId], references: [id], onDelete: SetNull)
  events        LeadEvent[]
  sessions      LeadSession[]

  @@index([status])
  @@index([createdAt])
  @@index([packageId])
  @@index([utmSource])
  @@index([utmCampaign])
  @@index([assignedAdminId])
}

/// Anonymous pre-submission journey. No PII, IP, or fingerprint storage.
model LeadSession {
  id                String    @id @default(cuid())
  sessionToken      String    @unique
  source            String?
  referrer          String?
  landingUrl        String?
  utmSource         String?
  utmMedium         String?
  utmCampaign       String?
  utmContent        String?
  utmTerm           String?
  selectedPackageId String?
  leadId            String?
  startedAt         DateTime  @default(now())
  submittedAt       DateTime?
  lastActivityAt    DateTime  @default(now())
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  selectedPackage Package?          @relation(fields: [selectedPackageId], references: [id], onDelete: SetNull)
  lead            Lead?             @relation(fields: [leadId], references: [id], onDelete: SetNull)
  events          LeadSessionEvent[]

  @@index([leadId])
  @@index([selectedPackageId])
  @@index([lastActivityAt])
  @@index([startedAt])
}

model LeadSessionEvent {
  id        String               @id @default(cuid())
  sessionId String
  type      LeadSessionEventType
  step      String?
  metadata  Json?
  createdAt DateTime             @default(now())

  session LeadSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@index([type])
}

model LeadEvent {
  id        String        @id @default(cuid())
  leadId    String
  type      LeadEventType
  metadata  Json?
  createdAt DateTime      @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt])
  @@index([type])
}

// ---------------------------------------------------------------------------
// Admin CMS — authentication & audit (Phase 5)
// ---------------------------------------------------------------------------

/// Credentials-based admin account. No public registration; accounts are
/// created only via `scripts/create-admin.ts`. Auth.js issues JWT session
/// cookies — there is intentionally no AdminSession table.
model AdminUser {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         AdminRole @default(EDITOR)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  /// Soft-delete only — admin accounts are deactivated, never hard-deleted,
  /// so audit-log history keeps a valid author reference.
  deletedAt    DateTime?

  auditLogs     AdminAuditLog[]
  assignedLeads Lead[]

  @@index([role])
  @@index([isActive])
  @@index([deletedAt])
}

/// Append-only trail of admin mutations. `metadata` must only contain safe,
/// non-sensitive fields (never passwords, tokens, connection strings, or
/// full Lead PII payloads) — enforced by convention in the service layer.
model AdminAuditLog {
  id          String   @id @default(cuid())
  adminUserId String?
  action      String
  entityType  String
  entityId    String?
  metadata    Json?
  createdAt   DateTime @default(now())

  adminUser AdminUser? @relation(fields: [adminUserId], references: [id], onDelete: SetNull)

  @@index([adminUserId])
  @@index([entityType, entityId])
  @@index([createdAt])
}
