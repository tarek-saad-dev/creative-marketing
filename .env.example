# =============================================================================
# Creative Marketing — Environment placeholders
# Copy to .env.local and fill in real values. Never commit secrets.
# =============================================================================

# Neon pooled connection (application runtime / Prisma Client via adapter)
# Hostname should include "-pooler" and sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@YOUR-POOLED-ENDPOINT/DATABASE?sslmode=require"

# Neon direct connection (Prisma CLI migrations / introspection)
# Hostname should NOT include "-pooler" and must include sslmode=require
DIRECT_URL="postgresql://USER:PASSWORD@YOUR-DIRECT-ENDPOINT/DATABASE?sslmode=require"

# Public site origin for sitemap / robots (no trailing slash)
NEXT_PUBLIC_SITE_URL="https://example.com"

# Runtime (usually set by the host; included for local clarity)
NODE_ENV="development"

# =============================================================================
# Admin CMS (Phase 5) — Auth.js (next-auth v5)
# =============================================================================

# Session/JWT signing secret. REQUIRED in production; generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Optional in local development (a warning is logged if missing; sessions
# are then only valid for the current dev process).
AUTH_SECRET=""

# Canonical origin Auth.js uses to build callback/cookie URLs. Optional in
# local dev (inferred from the request); recommended to set explicitly in
# production behind a proxy/CDN.
AUTH_URL="https://example.com"

# =============================================================================
# Cloudinary (Phase 5) — admin media uploads (optional until configured)
# =============================================================================
# All three are required together to enable the admin media uploader. When
# unset, the admin UI disables uploads and shows a "not configured" notice;
# no other Phase 5 feature depends on Cloudinary being present.

CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
